# Codify 功能地图
# d2 docs/FEATURE_MAP.d2 docs/FEATURE_MAP.svg --pad 24 --theme 0 --layout dagre

vars: {
  d2-config: {
    layout-engine: dagre
  }
}

styles: {
  style.opacity: 1
  style.stroke-width: 1
  style.font-size: 13
  style.border-radius: 6
  style.shadow: false
}

# ================================================================
# 纯纵向树 - 6 行 × 向右展开
# ================================================================

# 行 1: 核心引擎
engine: "🧠 核心引擎" {
  style.fill: "#E3F2FD"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  task: "任务生命周期\n\n创建 — 手动/重试/CI修复 · Provider/Profile/Prompt模板 · P0-P2 · execute/plan\n调度 — P0>P1>P2定时优先 · concurrency · Issue互斥锁 · 崩溃恢复\n执行 — Docker隔离 · 环境变量 · Volume · Claude CLI · SSH · 脱敏 · 超时取消\n结果 — MR · 代码统计 · Token · Commit · 状态覆盖 · RESUME续接" {
    style.fill: "#BBDEFB"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  }
  issue: "Issue 管理\n\nCRUD · 分支自动命名 · 关闭删分支 · 409防删除\nbase/target branch · OPEN→CLOSED状态流转\n默认Provider/Profile · CI修复开关" {
    style.fill: "#BBDEFB"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  }
}

# 行 2: 数据洞察
data: "📊 数据与洞察" {
  style.fill: "#E8F5E9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  logs: "日志与可观测\n\n结构化 — thinking/tool_call/assistant_text/system_init · Payload懒加载\n原始 — TaskRawLogChunk分块 · SSE推送 · 容器轮询\n归档 — event.jsonl+runtime.json打包下载" {
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
  delivery: "AI交付物展示\n\nMarkdown摘要 · Mermaid SVG · 缩放弹窗 · 拖拽平移\nTaskContinuationPanel后续引导" {
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
  stats: "统计分析\n\nDashboard · 热力图 · MyWorkBoard\nAnalytics 7/30/90天 · Provider对比\n调度热力图 · slot容量" {
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
  monitor: "系统监控\n\n队列压力 · Worker对齐 · 失败率\n容器列表 · Kanban看板" {
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
}

# 行 3: 配置中心
config: "⚙️ 配置中心" {
  style.fill: "#FFF3E0"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  runtime: "运行时\n\nconcurrency · timeout · slot · 公告\nWorker Volume · 全局环境变量\nFernet加密 · 单key/全量重置" {
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  gitlab: "GitLab/OIDC/告警\n\nURL/Token · 连接测试 · Webhook\nissuer/client · 诊断 · Session\n告警webhook" {
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  provider: "AI Provider\n\nCRUD · 默认 · 启用禁用\nbase_url/model/max_turns" {
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  profile: "Worker Profile\n\nCRUD+复制 · Codegraph · Volume\n三模板 · 不可变快照" {
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  template: "提示词模板\n\nCRUD · tags · sort_order\n标签筛选选择器" {
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
}

# 行 4: 协作集成
collab: "🔔 协作与集成" {
  style.fill: "#F3E5F5"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  mattermost: "Mattermost通知\n\nChannel/DM · @mention · 6事件\n用户自动映射 · 投递追踪" {
    style.fill: "#E1BEE7"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  }
  gitlab: "GitLab集成\n\n项目/分支 · Webhook管理 · Secret\n事件日志 · MR自动创建 · Draft" {
    style.fill: "#E1BEE7"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  }
  ci: "CI失败自动修复\n\nWebhook接收 · Pipeline识别\n证据收集 · 根因分析 · 并发锁\nIssue匹配 · 自动修复 · Collector" {
    style.fill: "#E1BEE7"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  }
}

# 行 5: 平台治理
govern: "🛡️ 平台治理" {
  style.fill: "#FFEBEE"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  users: "用户与权限\n\nOIDC · 本地密码 · Break-glass · 审计\n会话管理 · Token加密 · 角色权限 · Bootstrap" {
    style.fill: "#FFCDD2"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  }
  usage: "用量管理\n\n日/周Token · 日/周任务 · 三种模式\n账本 · 双关口阻断 · 管理员编辑" {
    style.fill: "#FFCDD2"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  }
  ops: "系统运维\n\n数据清理 · Alembic迁移 · prompt回填\n/health · Trace-ID · 500异常处理" {
    style.fill: "#FFCDD2"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  }
}

# 行 6: 前端设施
fe: "🎨 前端基础设施" {
  style.fill: "#E0F2F1"; style.stroke: "#00897B"; style.font-color: "#004D40"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  i18n: "国际化与UI\n\n中英文 · Naive-UI · 响应式断点" {
    style.fill: "#B2DFDB"; style.stroke: "#00897B"; style.font-color: "#004D40"
  }
  components: "组件\n\nPageHeader · FilterToolbar · HeatmapChart\nTaskFormDrawer · TaskProcessPanel · 配置面板" {
    style.fill: "#B2DFDB"; style.stroke: "#00897B"; style.font-color: "#004D40"
  }
  apilogic: "API与逻辑\n\nAxios · 401跳转 · Trace-ID\nComposables(6通用+14Feature) · 工具函数" {
    style.fill: "#B2DFDB"; style.stroke: "#00897B"; style.font-color: "#004D40"
  }
}

# 连接: 引擎 → 数据
engine.task -> data.logs: "产出日志" { style.stroke-dash: 3; style.stroke: "#90A4AE" }

# 连接: 引擎 → 通知
engine.task -> collab.mattermost: "触发通知" { style.stroke-dash: 3; style.stroke: "#90A4AE" }

# 连接: 引擎 ← 配置中心
engine.task -> config.runtime: "读取配置" { style.stroke-dash: 3; style.stroke: "#90A4AE" }

# 强制纵向堆叠
engine -> data -> config -> collab -> govern -> fe { style.opacity: 0 }
