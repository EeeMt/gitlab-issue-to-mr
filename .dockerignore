# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# Python
__pycache__
*.py[cod]
*.egg-info
.eggs
dist
build
.venv
venv
.env

# Node
node_modules
npm-debug.log
yarn-error.log

# Tests
tests/
coverage/
*.test.*
*.spec.*

# Docs
docs/
*.md
!README.md

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Include deploy directory (required for worker image build)
!deploy/
# Worker Kit export stages only the selected Harness payloads here. Keep the
# parent directories traversable while excluding the large source payloads.
deploy/worker-cli/**
!deploy/worker-cli/
!deploy/worker-cli/kit-staging/
!deploy/worker-cli/kit-staging/**
# Re-apply generated-file exclusions after the deploy negation above.
deploy/**/__pycache__/
deploy/**/*.py[cod]

# Generated offline artifacts are large and are never inputs to application/worker images.
deploy/offline-bundle/
deploy/codify-offline-bundle*.tar.gz
deploy/.codify-offline-bundle*.tmp

# Misc
*.log
logs/
*.tmp
*.temp
.env.local
.env.*.local
