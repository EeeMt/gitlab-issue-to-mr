# Stage 1: Build Python virtual environment.
# Heavy build tools (gcc, libpq-dev) stay here; only the venv is carried forward.
# Re-runs only when requirements.txt changes.
FROM ubuntu:22.04 AS python-builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3-pip \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m venv /venv

COPY backend/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    /venv/bin/pip install --no-cache-dir -r requirements.txt

# Stage 2: Runtime image.
# System tools and Java are stable layers; only the app source is frequently changing.
FROM ubuntu:22.04 AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python 3.11 runtime
    python3.11 \
    python3.11-venv \
    # PostgreSQL client runtime lib
    libpq5 \
    # Base tools
    curl \
    wget \
    bash \
    ca-certificates \
    # Network tools
    iputils-ping \
    dnsutils \
    net-tools \
    netcat-openbsd \
    # Process tools
    procps \
    # File/compression tools
    tar \
    gzip \
    # Text tools
    vim-tiny \
    less \
    # Other utilities
    git \
    openssl \
    jq \
    file \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

ENV PATH="/venv/bin:${PATH}"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Copy pre-built venv from builder stage (cached until requirements.txt changes)
COPY --from=python-builder /venv /venv

# Copy entrypoint script
COPY deploy/entrypoint.backend.sh /entrypoint.sh
COPY deploy/scripts/run-migration-owner.sh /usr/local/bin/run-migration-owner

RUN chmod +x /entrypoint.sh /usr/local/bin/run-migration-owner

# Variable part: application source code (invalidates only these final layers)
COPY backend/app/ ./app/
COPY backend/alembic/ ./alembic/
COPY backend/alembic.ini .
COPY backend/pyproject.toml .
# Controlled Runtime Bundle source. Scheduler/backend package this content and
# upload it through the Docker API; Worker execution never depends on this host path.
COPY deploy/entrypoint.worker.sh /opt/codify/runtime-source/deploy/entrypoint.worker.sh
COPY deploy/ci-claude.sh /opt/codify/runtime-source/deploy/ci-claude.sh
COPY deploy/worker-entrypoint/ /opt/codify/runtime-source/deploy/worker-entrypoint/
RUN chmod -R a+rX /opt/codify/runtime-source \
    && chmod 755 /opt/codify/runtime-source/deploy/entrypoint.worker.sh \
      /opt/codify/runtime-source/deploy/ci-claude.sh

ENV CODIFY_RUNTIME_SOURCE_DIR=/opt/codify/runtime-source

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
