# Stage 1: Build Python virtual environment.
# Heavy build tools (gcc, libpq-dev) stay here; only the venv is carried forward.
# Re-runs only when requirements.txt changes.
FROM ubuntu:22.04 AS python-builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3-pip \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m venv /venv

COPY backend/requirements.txt .
RUN /venv/bin/pip install --no-cache-dir -r requirements.txt

# Stage 2: Runtime image.
# System tools and Java are stable layers; only the app source is frequently changing.
FROM ubuntu:22.04 AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python 3.11 runtime
    python3.11 \
    python3.11-venv \
    # PostgreSQL client runtime lib
    libpq5 \
    # Base tools
    curl \
    wget \
    bash \
    ca-certificates \
    # Network tools
    iputils-ping \
    dnsutils \
    net-tools \
    netcat-openbsd \
    # Process tools
    procps \
    # File/compression tools
    tar \
    gzip \
    # Text tools
    vim-tiny \
    less \
    # Other utilities
    git \
    openssl \
    jq \
    file \
    # Java 21 + Maven
    openjdk-21-jdk \
    maven \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:/venv/bin:${PATH}"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Copy pre-built venv from builder stage (cached until requirements.txt changes)
COPY --from=python-builder /venv /venv

# Copy custom CA certificate into the image
COPY ca.crt /etc/ssl/certs/custom-ca.crt

# Copy entrypoint script
COPY deploy/entrypoint.backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Variable part: application source code (invalidates only these final layers)
COPY backend/app/ ./app/
COPY backend/alembic/ ./alembic/
COPY backend/alembic.ini .
COPY backend/pyproject.toml .

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
