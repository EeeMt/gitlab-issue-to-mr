ANTHROPIC_MODEL=MiniMax-M2.7

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://codify:codify_password@postgres:5432/codify

# Docker Engine HTTP API (TLS)
DOCKER_HOST=tcp://docker.example.com:2376

# Application
SECRET_KEY=your-secret-key-change-in-production
LOG_LEVEL=INFO
BACKEND_URL=http://192.168.50.129:8000
FRONTEND_URL=http://192.168.50.129:8880

# Worker Configuration
WORKER_IMAGE=codify-worker:latest

# Scheduler Configuration (P1)
MAX_CONCURRENCY=3
TASK_TIMEOUT=1800
SCHEDULER_INTERVAL=5
DEFAULT_TARGET_BRANCH=main

CONFIG_ENCRYPTION_KEY=dev-oidc-config-key

# Custom CA Certificate
# Place /opt/ca.crt on the Docker host (not committed to git).
# docker-compose.yml mounts /opt/ca.crt into backend/scheduler at /etc/ssl/certs/custom-ca.crt.
# WORKER_CA_CERT_HOST_PATH passes the cert into spawned worker containers automatically.
# Set this to the ABSOLUTE path of ca.crt on the Docker host.
CUSTOM_CA_BUNDLE=/etc/ssl/certs/custom-ca.crt
WORKER_CA_CERT_HOST_PATH=/opt/ca.crt
