# Local deployment template. Inject all real secrets through a protected
# environment or secret store; never write them into this tracked file.

# GitLab Configuration
GITLAB_URL=http://gitlab.example.test:8080
GITLAB_BOT_TOKEN=replace-via-secret-store
GITLAB_WEBHOOK_SECRET=replace-via-secret-store

# Model Provider (local placeholder values only)
ANTHROPIC_BASE_URL=https://provider.example.test/anthropic
ANTHROPIC_API_KEY=replace-via-secret-store
ANTHROPIC_MODEL=example-model

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://codify:codify_password@postgres:5432/codify

# Docker Engine API
DOCKER_HOST=tcp://docker.example.com:2376

# Application
SECRET_KEY=replace-via-secret-store
LOG_LEVEL=INFO
BACKEND_URL=http://backend.example.test:8000
FRONTEND_URL=http://frontend.example.test:8880

# Worker Configuration
WORKER_IMAGE=codify-worker/java21-maven:2026.08

# Scheduler Configuration
MAX_CONCURRENCY=3
TASK_TIMEOUT=1800
SCHEDULER_INTERVAL=5
DEFAULT_TARGET_BRANCH=main
HARNESS_EXECUTION_MODE=dual_canary

CONFIG_ENCRYPTION_KEY=replace-via-secret-store

# Custom CA Certificate
# Place the certificate on the Docker host; do not commit it.
CUSTOM_CA_BUNDLE=/etc/ssl/certs/custom-ca.crt
WORKER_CA_CERT_HOST_PATH=/opt/ca.crt

WORKER_WORKSPACE_HOST_PATH=/opt/codify-workspaces
