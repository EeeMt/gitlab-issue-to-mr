ANTHROPIC_MODEL=MiniMax-M2.5

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://gimr:gimr_password@postgres:5432/gimr

# Docker Engine HTTP API (TLS)
DOCKER_HOST=tcp://docker.example.com:2376

# Application
SECRET_KEY=your-secret-key-change-in-production
LOG_LEVEL=INFO
BACKEND_URL=http://192.168.50.129:8000
FRONTEND_URL=http://192.168.50.129:8880

# Worker Configuration
WORKER_IMAGE=deploy-worker:latest

# Scheduler Configuration (P1)
MAX_CONCURRENCY=3
TASK_TIMEOUT=1800
SCHEDULER_INTERVAL=5
DEFAULT_TARGET_BRANCH=main

CONFIG_ENCRYPTION_KEY=dev-oidc-config-key

# Custom CA Certificate
# The CA certificate is baked into the backend and worker images at /etc/ssl/certs/custom-ca.crt
CUSTOM_CA_BUNDLE=/etc/ssl/certs/custom-ca.crt
