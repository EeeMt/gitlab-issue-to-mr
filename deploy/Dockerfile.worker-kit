# syntax=docker/dockerfile:1.7

ARG NIX_IMAGE=nixos/nix:2.24.11
ARG WORKER_KIT_VERSION=0.4.0
# Build selection: comma/plus-separated subset of pi,opencode,claude,codex.
# An empty value builds a Kit with no Harness CLI payloads. The manifest
# always records all four keys (availability=present|absent + reason_code).
ARG KIT_CLI_SELECTION=pi,opencode

FROM --platform=$BUILDPLATFORM golang:1.24-alpine AS launcher-builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY deploy/worker-kit/launcher/main.go ./launcher/main.go
COPY deploy/worker-kit/run-as/main.go ./run-as/main.go
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags='-s -w' -o /out/launcher ./launcher/main.go \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags='-s -w' -o /out/codify-run-as ./run-as/main.go

FROM ${NIX_IMAGE} AS closure-builder
# Some macOS-hosted Linux build environments reject Nix's nested seccomp BPF
# program, including native arm64 builds on Apple Silicon. This stage already
# runs inside BuildKit's container sandbox, so disable only Nix's filter.
ENV NIX_CONFIG="filter-syscalls = false"
ARG KIT_CLI_SELECTION
ARG TARGETARCH
ARG PI_CLI_VERSION
ARG OPENCODE_CLI_VERSION
ARG CLAUDE_CLI_VERSION
ARG CODEX_CLI_VERSION
WORKDIR /src
COPY deploy/worker-kit/default.nix ./default.nix
COPY deploy/worker-kit/nixpkgs.json ./nixpkgs.json
COPY deploy/worker-kit/npm/ ./npm/
COPY deploy/scripts/validate_mermaid_summary.mjs ./validate_mermaid_summary.mjs
COPY deploy/worker-kit/verify-cli-payloads.sh ./verify-cli-payloads.sh
# Only selected payloads are staged here by the exporter (deploy/worker-cli/kit-staging).
# Unselected payloads never enter the Kit, so the manifest's absent entries
# cannot conflict with shipped files.
COPY deploy/worker-cli/kit-staging/ /payloads/
RUN nix-build default.nix -o /tmp/codify-worker-kit-runtime \
    && readlink -f /tmp/codify-worker-kit-runtime > /tmp/runtime-store-path \
    && nix-instantiate --eval --strict -E '(import ./default.nix {}).nixpkgsVersion' \
      | tr -d '"' > /tmp/nixpkgs-version \
    && nix-instantiate --eval --strict -E '(import ./default.nix {}).nixpkgsRevision' \
      | tr -d '"' > /tmp/nixpkgs-revision \
    && mkdir -p /out/nix/store \
    && cp -a --parents $(nix-store -qR /tmp/codify-worker-kit-runtime) /out \
    && GLIBC_LOADER="$(nix-store -qR /tmp/codify-worker-kit-runtime \
         | while read -r p; do \
             case "${TARGETARCH}" in \
               arm64) l="${p}/lib/ld-linux-aarch64.so.1" ;; \
               *) l="${p}/lib/ld-linux-x86-64.so.2" ;; \
             esac; \
             [ -f "${l}" ] && { printf '%s\n' "${l}"; break; }; \
           done)" \
    && JQ_BIN="$(readlink -f /tmp/codify-worker-kit-runtime)/bin/jq" \
       GLIBC_LOADER="${GLIBC_LOADER}" \
       KIT_CLI_SELECTION="${KIT_CLI_SELECTION}" \
       PI_CLI_VERSION="${PI_CLI_VERSION}" \
       OPENCODE_CLI_VERSION="${OPENCODE_CLI_VERSION}" \
       CLAUDE_CLI_VERSION="${CLAUDE_CLI_VERSION}" \
       CODEX_CLI_VERSION="${CODEX_CLI_VERSION}" \
       /src/verify-cli-payloads.sh

FROM alpine:3.21 AS artifact
ARG WORKER_KIT_VERSION=0.4.0
ARG TARGETARCH
ARG KIT_CLI_SELECTION
RUN apk add --no-cache jq
COPY --from=launcher-builder /out/launcher /worker-kit/launcher
COPY --from=launcher-builder /out/codify-run-as /worker-kit/bin/codify-run-as
COPY --from=closure-builder /out/nix /worker-kit/nix
COPY --from=closure-builder /tmp/runtime-store-path /tmp/runtime-store-path
COPY --from=closure-builder /tmp/nixpkgs-version /tmp/nixpkgs-version
COPY --from=closure-builder /tmp/nixpkgs-revision /tmp/nixpkgs-revision
COPY --from=closure-builder /tmp/payload-evidence.json /tmp/payload-evidence.json
COPY --from=closure-builder /payloads/ /worker-kit/harness/
COPY deploy/entrypoint.worker.sh /worker-kit/entrypoint.sh
COPY deploy/ci-claude.sh /worker-kit/ci-claude.sh
COPY deploy/worker-entrypoint/ /worker-kit/worker-entrypoint/
COPY deploy/worker-kit/bridge-selfcheck.sh /worker-kit/bridge-selfcheck.sh
COPY deploy/worker-kit/verify-kit-content.py /worker-kit/verify-kit-content.py
COPY deploy/worker-kit/verify-runtime.sh /worker-kit/verify-runtime.sh
COPY deploy/worker-kit/validate-runtime-manifest.py /worker-kit/validate-runtime-manifest.py
COPY deploy/scripts/validate_mermaid_summary.mjs /worker-kit/validate_mermaid_summary.mjs
RUN runtime_store="$(cat /tmp/runtime-store-path)" \
    && nixpkgs_version="$(cat /tmp/nixpkgs-version)" \
    && nixpkgs_revision="$(cat /tmp/nixpkgs-revision)" \
    && inventory="$(jq -n --argjson evidence "$(cat /tmp/payload-evidence.json)" --arg selection "${KIT_CLI_SELECTION:-}" 'reduce ["pi","opencode","claude","codex"][] as $key ({}; .[$key] = (if ($evidence.present | has($key)) then ({availability: "present"} + $evidence.present[$key]) elif (($selection | split(",|\\+"; null) | map(select(length > 0))) | index($key)) then {availability: "absent", reason_code: "missing_payload"} else {availability: "absent", reason_code: "not_selected"} end))')" \
    && jq -n \
      --arg version "${WORKER_KIT_VERSION}" \
      --arg platform "linux/${TARGETARCH}" \
      --arg runtime_bin "${runtime_store}/bin" \
      --arg bash "${runtime_store}/bin/bash" \
      --arg nixpkgs_version "${nixpkgs_version}" \
      --arg nixpkgs_revision "${nixpkgs_revision}" \
      --argjson harness_inventory "${inventory}" \
      '{schema_version: 2, manifest_kind:"codify.worker.kit-manifest/v1", kit_version: $version, platform: $platform, runtime_bin: $runtime_bin, bash: $bash, entrypoint: "/opt/codify-kit/entrypoint.sh", runtime_compatibility: {harness_contracts:["codify.worker.harness/v2","codify.worker.harness/v1"], event_schemas:["codify.worker.event/v2","codify.worker.event/v1"], bootstrap_version:"1.0.0"}, harness_inventory: $harness_inventory, components: {nixpkgs: $nixpkgs_version, nixpkgs_revision: $nixpkgs_revision}}' \
      > /worker-kit/manifest.json \
    && test "$(jq -r '.harness_inventory | keys | length' /worker-kit/manifest.json)" = 4 \
    && for key in pi opencode claude codex; do availability="$(jq -r --arg k "${key}" '.harness_inventory[$k].availability' /worker-kit/manifest.json)"; if [ "${availability}" = "present" ]; then test -x "/worker-kit/$(jq -r --arg k "${key}" '.harness_inventory[$k].path | sub("^/opt/codify-kit/"; "")' /worker-kit/manifest.json)"; fi; done \
    && chmod 755 /worker-kit/launcher /worker-kit/bin/codify-run-as /worker-kit/entrypoint.sh \
      /worker-kit/ci-claude.sh \
      /worker-kit/verify-kit-content.py \
      /worker-kit/verify-runtime.sh \
      /worker-kit/validate-runtime-manifest.py \
      /worker-kit/bridge-selfcheck.sh \
      /worker-kit/worker-entrypoint/legacy/pi-run.sh \
      /worker-kit/worker-entrypoint/legacy/opencode-run.sh \
      /worker-kit/worker-entrypoint/legacy/codex-run.sh \
      /worker-kit/worker-entrypoint/harness/adapters/pi.sh \
      /worker-kit/worker-entrypoint/harness/adapters/opencode.sh \
      /worker-kit/worker-entrypoint/harness/adapters/claude.sh \
      /worker-kit/worker-entrypoint/harness/adapters/codex.sh \
    && for harness in claude codex pi opencode; do cp /worker-kit/bridge-selfcheck.sh "/worker-kit/bridge-selfcheck-${harness}"; done \
    && mkdir -p /nix \
    && ln -s /worker-kit/nix/store /nix/store \
    && runtime_python="/worker-kit$(cat /tmp/runtime-store-path)/bin/python3" \
    && "${runtime_python}" /worker-kit/verify-kit-content.py --root /worker-kit --write-manifest \
    && rm /nix/store \
    && test -d /worker-kit/nix/store \
    && test -s /worker-kit/manifest.json \
    && test -x /worker-kit/bridge-selfcheck-claude \
    && test -x /worker-kit/bridge-selfcheck-codex \
    && test -x /worker-kit/bridge-selfcheck-pi \
    && test -x /worker-kit/bridge-selfcheck-opencode \
    && test -x /worker-kit/ci-claude.sh \
    && test -x /worker-kit/worker-entrypoint/legacy/pi-run.sh \
    && test -x /worker-kit/worker-entrypoint/legacy/opencode-run.sh \
    && test -x /worker-kit/worker-entrypoint/legacy/codex-run.sh \
    && test -d /worker-kit/worker-entrypoint/harness/adapters \
    && test -s /worker-kit/worker-entrypoint/harness/manifest.json

FROM alpine:3.21 AS smoke
ARG WORKER_KIT_VERSION
ARG TARGETARCH
COPY --from=artifact /worker-kit /opt/codify-kit
COPY --from=artifact /worker-kit/nix/store /nix/store
# Every present inventory entry must pass its functionality gate inside the
# Kit's own runtime; absent entries are recorded with their reason code.
# `pi --version` may need a writable home, so give the smoke container one.
# Alpine is musl and cannot exec glibc payloads directly, so install the nix
# closure's glibc as an ABI shim at the standard loader/lib paths first.
RUN mkdir -p /workspace /root \
    && chmod 0777 /workspace \
    && GLIBC_LIB="$(ls -d /nix/store/*-glibc-*/lib | head -1)" \
    && if [ "${TARGETARCH}" = "arm64" ]; then \
         mkdir -p /lib/aarch64-linux-gnu; \
         cp "${GLIBC_LIB}/ld-linux-aarch64.so.1" /lib/; \
         cp "${GLIBC_LIB}/libc.so.6" "${GLIBC_LIB}/libpthread.so.0" "${GLIBC_LIB}/libdl.so.2" "${GLIBC_LIB}/libm.so.6" /lib/aarch64-linux-gnu/; \
       else \
         mkdir -p /lib64 /lib/x86_64-linux-gnu; \
         cp "${GLIBC_LIB}/ld-linux-x86-64.so.2" /lib64/; \
         cp "${GLIBC_LIB}/libc.so.6" "${GLIBC_LIB}/libpthread.so.0" "${GLIBC_LIB}/libdl.so.2" "${GLIBC_LIB}/libm.so.6" /lib/x86_64-linux-gnu/; \
       fi \
    && CODIFY_KIT_VERSION="${WORKER_KIT_VERSION}" /opt/codify-kit/launcher --verify \
      --require-skill-support \
      --smoke 'test "$(command -v sh)" = /bin/sh' \
    && touch /worker-kit-smoke-passed

FROM artifact AS final
COPY --from=smoke /worker-kit-smoke-passed /worker-kit/.smoke-passed
CMD ["/bin/sh"]
