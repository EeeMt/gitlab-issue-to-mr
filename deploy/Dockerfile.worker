# Project runtime image for mounted worker-kit profiles.
#
# Codify-owned tools, entrypoint scripts, CodeGraph, Mermaid validation, and ci-claude
# are supplied by the mounted worker kit. Claude CLI is supplied by the worker profile,
# usually through a read-only volume mounted at /usr/local/bin/claude.
FROM python:3.12-slim

WORKDIR /workspace

# Keep this image focused on project build tools. The worker kit supplies Git, SSH,
# curl, jq, ripgrep, Node.js, Python helpers, and Codify orchestration scripts.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    openjdk-21-jdk \
    maven \
    && java -version \
    && mvn -version \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash --uid 1000 codify \
    && mkdir -p /workspace /home/codify/.m2/repository \
    && chown -R codify:codify /workspace /home/codify/.m2

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:/usr/local/bin:/usr/bin:${PATH}"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

CMD ["/bin/sh"]
