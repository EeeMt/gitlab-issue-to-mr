FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (Java 21, Maven, Node.js) in single layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    openjdk-21-jdk \
    maven \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Set Java environment
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install Python dependencies and Claude CLI
RUN pip install --no-cache-dir anthropic requests anthropic-cli

# Install Claude CLI via npm
RUN npm install -g @anthropic-ai/claude-cli 2>/dev/null || echo "Claude CLI via npm failed, using pip"

# Copy and set entrypoint
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
