{
  "schema": "codify.worker.runtime-manifest/v1",
  "contract_version": "codify.worker.harness/v1",
  "event_schema": "codify.worker.event/v1",
  "orchestration_version": "1.0.0",
  "adapters": {
    "claude": {
      "version": "1.0.1",
      "cli_version_range": ">=2.1.33 <3.0.0",
      "provider_protocols": ["anthropic-messages"],
      "capabilities": {
        "resume": true,
        "task_skills": true,
        "max_turns": true,
        "usage_tokens": true,
        "usage_cost": true,
        "run_text": true,
        "codegraph": true,
        "sandbox_mode": "container-boundary"
      }
    },
    "codex": {
      "version": "1.0.0",
      "cli_version_range": ">=0.146.0 <0.160.0",
      "provider_protocols": ["openai-responses"],
      "capabilities": {
        "resume": true,
        "task_skills": true,
        "max_turns": false,
        "usage_tokens": true,
        "usage_cost": true,
        "run_text": false,
        "codegraph": false,
        "sandbox_mode": "container-boundary"
      }
    },
    "pi": {
      "version": "2.0.0",
      "cli_version": "0.84.2",
      "cli_version_range": ">=0.84.2 <0.85.0",
      "provider_protocols": ["anthropic-messages", "openai-responses", "openai-chat-completions"],
      "options_schema": "pi/v1",
      "capabilities": {
        "resume": true,
        "task_skills": true,
        "max_turns": false,
        "usage_tokens": true,
        "usage_cost": true,
        "run_text": false,
        "codegraph": false,
        "steering": true,
        "follow_up": true,
        "sandbox_mode": "container-boundary"
      }
    }
  }
}
