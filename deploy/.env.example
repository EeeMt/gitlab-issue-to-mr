# Codify — example environment configuration
# Copy this file to .env (production) or .env.test (dev/test) and fill in real values.
# .env and .env.test are excluded from git (.gitignore).

# ---------------------------------------------------------------------------
# GitLab
# ---------------------------------------------------------------------------
GITLAB_URL=https://gitlab.example.com
GITLAB_BOT_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=change-me-webhook-secret

# ---------------------------------------------------------------------------
# Claude CLI (passed into worker containers at runtime)
# ---------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Model to use, e.g. claude-opus-4-5, claude-sonnet-4-5, or a custom model
ANTHROPIC_MODEL=claude-opus-4-5

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Use the service name "postgres" inside Docker Compose, or an external host.
DATABASE_URL=postgresql+asyncpg://codify:change-me-db-password@postgres:5432/codify

# ---------------------------------------------------------------------------
# Docker Engine API
# ---------------------------------------------------------------------------
# Scheduler connects here to spawn worker containers.
# Use unix:///var/run/docker.sock for local Docker, or tcp://host:2376 for TLS.
DOCKER_HOST=unix:///var/run/docker.sock

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-secret-key
LOG_LEVEL=INFO
SQLALCHEMY_ECHO=false    # Set true to log all SQL queries (very noisy, use for debugging only)
FRONTEND_URL=http://localhost:8880

# ---------------------------------------------------------------------------
# Worker Configuration
# ---------------------------------------------------------------------------
WORKER_IMAGE=codify-worker/java21-maven:2026.07

# Persistent issue workspace. This deployment-time path is bind-mounted into
# Backend and Scheduler and must exist at the same path on every Docker host.
WORKER_WORKSPACE_HOST_PATH=/opt/codify-workspaces

# Days to keep issue workspace directories before automatic cleanup.
# Scheduler scans every 6 hours and removes directories with no recent activity.
WORKER_WORKSPACE_RETENTION_DAYS=14
WORKER_FAILED_WORKSPACE_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Scheduler Configuration
# ---------------------------------------------------------------------------
MAX_CONCURRENCY=3
TASK_TIMEOUT=1800
SCHEDULER_INTERVAL=5
DEFAULT_TARGET_BRANCH=main

# ---------------------------------------------------------------------------
# Config Encryption
# ---------------------------------------------------------------------------
# Key used to encrypt sensitive config values stored in the database.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=change-me-encryption-key

# ---------------------------------------------------------------------------
# Custom CA Certificate (optional)
# ---------------------------------------------------------------------------
# If your GitLab / Mattermost / etc. use a self-signed or private CA,
# place the CA bundle file at deploy/ca.crt on the Docker host (not in git).
# docker-compose.yml mounts ./ca.crt into backend/scheduler.
# Leave these unset if no custom CA is needed.
#
# CUSTOM_CA_BUNDLE tells the containers where the cert is mounted:
CUSTOM_CA_BUNDLE=/etc/ssl/certs/custom-ca.crt
#
# WORKER_CA_CERT_HOST_PATH tells the scheduler to mount this cert into every spawned
# worker container. Set to the ABSOLUTE path of deploy/ca.crt on the Docker host.
# Simpler alternative to encoding a full JSON entry in WORKER_VOLUME_MOUNTS.
#
# WORKER_CA_CERT_HOST_PATH=/srv/codify/deploy/ca.crt
#
# For advanced use — full JSON mount list (takes precedence per-entry):
# WORKER_VOLUME_MOUNTS=[{"host_path":"/srv/codify/deploy/ca.crt","container_path":"/etc/ssl/certs/custom-ca.crt","mode":"ro"}]
