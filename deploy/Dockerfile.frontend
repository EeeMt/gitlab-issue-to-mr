# Stage 1: Build the Vue app.
# Node modules layer is cached until package-lock.json changes;
# only the source COPY + build step re-runs on code changes.
FROM node:22-alpine AS node-builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --silent

COPY frontend/ .
# Skip type checking during production build (vue-tsc --noEmit)
# Use vite build directly for faster builds
RUN npx vite build

# Stage 2: Serve static files with nginx.
# Only the compiled dist and nginx config live here; node_modules are discarded.
FROM nginx:alpine

COPY --from=node-builder /app/dist/ /usr/share/nginx/html/

RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        resolver 127.0.0.11 ipv6=off; \
        set $backend_upstream http://backend:8000; \
        proxy_pass $backend_upstream$request_uri; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_pass_header Set-Cookie; \
        proxy_pass_header Access-Control-Allow-Origin; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
