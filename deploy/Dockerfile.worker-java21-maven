# syntax=docker/dockerfile:1.7

# Java 21 + Maven project runtime image for mounted worker-kit profiles.
#
# This image provides only the project toolchain (Java 21, Maven, Git, SSH,
# curl, CA tooling) plus the Codify workspace/UID layout. It no longer carries
# or locks any Harness CLI: the four Harness CLIs (pi/opencode/claude/codex)
# are supplied by the Worker Kit, which is content-addressed and installed at
# /opt/codify/worker-kits/ (see deploy/worker-kit/export.sh and the Kit
# manifest). The Kit records each Harness' availability in harness_inventory.
FROM maven:3.9.9-eclipse-temurin-21

# Keep this image focused on project build tools. The worker kit supplies the
# Harness CLIs, jq, ripgrep, Node.js, Python helpers, and Codify orchestration
# scripts. The base Maven image already provides Java 21, Maven, Git, SSH,
# curl, and CA tooling.
ARG TARGETARCH

WORKDIR /workspace

RUN ln -sf /opt/java/openjdk/bin/java /usr/local/bin/java \
    && ln -sf /opt/java/openjdk/bin/keytool /usr/local/bin/keytool \
    && mkdir -p /workspace /home/codify/.m2/repository \
    && chown -R 1000:1000 /workspace /home/codify \
    && test -n "${TARGETARCH}" \
    && java -version \
    && keytool -help >/dev/null \
    && mvn -version

ENV JAVA_HOME=/opt/java/openjdk
ENV MAVEN_CONFIG=/home/codify/.m2
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8
ENV LANGUAGE=C

CMD ["/bin/sh"]
