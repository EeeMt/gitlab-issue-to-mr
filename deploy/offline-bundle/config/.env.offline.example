# ===============================
# Codify offline deployment config
# Copy this file to:
#   config/.env.offline
# Then replace the placeholder values.
# ===============================

# GitLab
GITLAB_URL=http://gitlab.internal:8080
GITLAB_BOT_TOKEN=replace-with-gitlab-bot-token
GITLAB_ADMIN_TOKEN=replace-with-gitlab-admin-token
GITLAB_WEBHOOK_SECRET=replace-with-random-webhook-secret

# Claude-compatible API
# If your offline environment uses an internal proxy / gateway / model endpoint,
# point ANTHROPIC_BASE_URL to that internal address.
ANTHROPIC_BASE_URL=http://llm-gateway.internal/v1
ANTHROPIC_API_KEY=replace-with-llm-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TURNS=20

# Application
SECRET_KEY=replace-with-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret
CONFIG_ENCRYPTION_KEY=replace-with-32-byte-or-longer-secret
LOG_LEVEL=INFO
BACKEND_URL=http://codify.internal:8000
FRONTEND_URL=http://codify.internal:8880

# Database
POSTGRES_USER=codify
POSTGRES_DB=codify
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql+asyncpg://codify:replace-with-strong-postgres-password@postgres:5432/codify

# Worker image
WORKER_IMAGE=codify-worker:latest

# Scheduler/runtime
MAX_CONCURRENCY=3
TASK_TIMEOUT=1800
SCHEDULER_INTERVAL=5
DEFAULT_TARGET_BRANCH=main
MAX_RETRIES=0
RETRY_DELAY=60
SLOT_MAX_TASKS=0
SLOT_MAX_TASKS_ENFORCE=false
ALERT_ON_FAILURE=false
ALERT_WEBHOOK_URL=

# Optional Mattermost integration bootstrap
MATTERMOST_SERVER_URL=
MATTERMOST_BOT_TOKEN=

# Optional Maven cache mounts for worker containers launched by the scheduler
MAVEN_CACHE_HOST_PATH=
MAVEN_SETTINGS_HOST_PATH=

# Worker container volume mounts and CA certificate propagation.
# WORKER_CA_CERT_HOST_PATH: absolute path on the Docker host to a CA cert file.
# This cert is auto-mounted into every worker container and trusted by git,
# Python, Node.js (Claude CLI), and the JDK.
WORKER_CA_CERT_HOST_PATH=
# WORKER_VOLUME_MOUNTS: JSON array of extra mounts, e.g.:
#   [{"host_path":"/data/cache","container_path":"/cache","mode":"rw"}]
WORKER_VOLUME_MOUNTS=

# Optional custom CA certificate (PEM) for environments that use an internal or
# self-signed certificate authority.
# Mount the CA file into the container (see docker-compose.yml comment) and set
# this variable to the in-container path, e.g.:
#   CUSTOM_CA_BUNDLE=/certs/ca.crt
# When set, the CA is trusted by git, Python, Node.js (Claude CLI), and the JDK
# inside every worker container, as well as the backend/scheduler HTTP clients.
CUSTOM_CA_BUNDLE=

# Optional dashboard auth / session settings
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
SESSION_COOKIE_NAME=codify_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_ADMIN_USERNAMES=
AUTH_ADMIN_GITLAB_GROUPS=
AUTH_BREAK_GLASS_ENABLED=false
AUTH_BREAK_GLASS_USERNAME=
AUTH_BREAK_GLASS_PASSWORD_HASH=

# Optional page permissions for non-admin users
ALLOW_MONITOR_FOR_USERS=false
ALLOW_SCHEDULE_OVERVIEW_FOR_USERS=false
ALLOW_ANALYTICS_FOR_USERS=false
ALLOW_OIDC_DIAGNOSTICS_FOR_USERS=false
