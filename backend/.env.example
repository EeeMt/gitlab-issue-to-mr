# GitLab Configuration
GITLAB_URL=https://gitlab.example.com
GITLAB_BOT_TOKEN=glpat-your-token-here
GITLAB_WEBHOOK_SECRET=your-webhook-secret

# Claude CLI (passed to Worker container)
ANTHROPIC_BASE_URL=http://host.docker.internal:11434/v1
ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://gimr:gimr_password@postgres:5432/gimr

# Docker Engine HTTP API (TLS)
DOCKER_HOST=tcp://docker.example.com:2376
DOCKER_TLS_CA=/path/to/ca.pem
DOCKER_TLS_CERT=/path/to/cert.pem
DOCKER_TLS_KEY=/path/to/key.pem

# Application
SECRET_KEY=your-secret-key-change-in-production
LOG_LEVEL=INFO

# Worker Configuration
WORKER_IMAGE=gitlab-issues-to-mr-worker:latest

# Scheduler Configuration (P1)
MAX_CONCURRENCY=3
TASK_TIMEOUT=1800
SCHEDULER_INTERVAL=5
DEFAULT_TARGET_BRANCH=main
MAX_RETRIES=0
RETRY_DELAY=60

# Alert Configuration
ALERT_ON_FAILURE=false
ALERT_WEBHOOK_URL=
